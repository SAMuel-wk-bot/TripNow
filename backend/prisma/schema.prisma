generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Users & Auth
// ============================================================

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String
  firstName      String
  lastName       String
  avatarUrl      String?
  role           UserRole      @default(USER)
  emailVerified  Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  trips          Trip[]
  bookings       Booking[]
  payments       Payment[]
  refreshTokens  RefreshToken[]
  aiConversations AiConversation[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================================
// Trips & Itineraries
// ============================================================

model Trip {
  id            String          @id @default(cuid())
  userId        String
  title         String
  destination   String
  startDate     DateTime
  endDate       DateTime
  budgetCents   Int?
  currency      String          @default("USD")
  status        TripStatus      @default(DRAFT)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  itineraryItems ItineraryItem[]
  bookings      Booking[]

  @@index([userId])
  @@map("trips")
}

enum TripStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ItineraryItem {
  id          String              @id @default(cuid())
  tripId      String
  type        ItineraryItemType
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  latitude    Float?
  longitude   Float?
  metadata    Json?
  orderIndex  Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  trip        Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("itinerary_items")
}

enum ItineraryItemType {
  FLIGHT
  CAR_RENTAL
  ACCOMMODATION
  ATTRACTION
  RESTAURANT
  ACTIVITY
  TRANSFER
  CUSTOM
}

// ============================================================
// Bookings (flights, cars, attractions)
// ============================================================

model Booking {
  id              String         @id @default(cuid())
  userId          String
  tripId          String?
  type            BookingType
  status          BookingStatus  @default(PENDING)
  provider        String
  providerRef     String?
  details         Json
  totalCents      Int
  currency        String         @default("USD")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip            Trip?          @relation(fields: [tripId], references: [id], onDelete: SetNull)
  payment         Payment?

  @@index([userId])
  @@index([tripId])
  @@map("bookings")
}

enum BookingType {
  FLIGHT
  CAR_RENTAL
  ATTRACTION
  ACCOMMODATION
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
  REFUNDED
}

// ============================================================
// Payments
// ============================================================

model Payment {
  id                  String          @id @default(cuid())
  userId              String
  bookingId           String?         @unique
  amountCents         Int
  currency            String          @default("USD")
  status              PaymentStatus   @default(PENDING)
  provider            String          @default("stripe")
  providerIntentId    String?         @unique
  providerCustomerId  String?
  metadata            Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking             Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

// ============================================================
// AI Conversations
// ============================================================

model AiConversation {
  id          String       @id @default(cuid())
  userId      String
  agentType   AiAgentType
  title       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    AiMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

enum AiAgentType {
  TRIP_PLANNER
  FLIGHT_HUNTER
  LOCAL_GUIDE
  BUDGET_ADVISOR
}

model AiMessage {
  id              String          @id @default(cuid())
  conversationId  String
  role            AiMessageRole
  content         String          @db.Text
  toolCalls       Json?
  createdAt       DateTime        @default(now())

  conversation    AiConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

// ============================================================
// Cached external data
// ============================================================

model Attraction {
  id            String   @id @default(cuid())
  externalId    String   @unique
  source        String
  name          String
  description   String?
  city          String
  country       String
  latitude      Float
  longitude     Float
  categories    String[]
  rating        Float?
  priceLevel    Int?
  openingHours  Json?
  imageUrl      String?
  metadata      Json?
  cachedAt      DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([city, country])
  @@map("attractions")
}
