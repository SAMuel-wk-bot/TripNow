# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://tripnow:tripnow_dev_password@localhost:5432/tripnow

# Redis (cache + rate limiting)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Logging
LOG_LEVEL=debug

# External APIs - Flights (e.g. Amadeus, Skyscanner, Duffel)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# External APIs - Cars (e.g. CarTrawler, Booking.com partner)
CAR_RENTAL_API_KEY=
CAR_RENTAL_BASE_URL=

# External APIs - Attractions / Places
GOOGLE_PLACES_API_KEY=
OPENTRIPMAP_API_KEY=

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# AI agents
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=claude-sonnet-4-6
